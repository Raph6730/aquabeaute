# Site Aqua Beauté (hébergement IONOS)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Anciennes adresses du site WordPress → nouvelles pages (conserve le référencement Google)
  RewriteRule ^visage/?$ /#soins/visage [R=301,NE,L]
  RewriteRule ^dos/?$ /#soins/corps [R=301,NE,L]
  RewriteRule ^epilation/?$ /#soins/epilation [R=301,NE,L]
  RewriteRule ^amincissante/?$ /#soins/minceur [R=301,NE,L]
  RewriteRule ^espace-beaute/?$ /#soins/regard [R=301,NE,L]
  RewriteRule ^soin-main-pied/?$ /#soins/mains [R=301,NE,L]
  RewriteRule ^bons-cadeaux/?$ /#bons-cadeaux [R=301,NE,L]
  RewriteRule ^a-propos/?$ / [R=301,L]
  RewriteRule ^accueil/?$ / [R=301,L]
  RewriteRule ^mentions-legales/?$ /#contact [R=301,NE,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
